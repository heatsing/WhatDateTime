{
  "name": "chronocraft",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/seo-check.mjs && opennextjs-cloudflare build --skipNextBuild && node scripts/prepare-sites.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "seo:generate": "node scripts/generate-seo-data.mjs && node scripts/generate-tool-content.mjs",
