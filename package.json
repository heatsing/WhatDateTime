{
  "name": "whatdatetime",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sitemap-shards.mjs && node scripts/seo-check.mjs",
    "start": "astro preview",
    "test": "node scripts/calculation-tests.mjs",
    "test:seo-descriptions": "node scripts/seo-description-tests.mjs",
    "lint": "astro check",
    "seo:generate": "node scripts/generate-seo-data.mjs && node scripts/generate-tool-content.mjs",
    "seo:baseline": "node scripts/create-seo-baseline.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:check": "node scripts/seo-audit.mjs && node scripts/generate-sitemap-shards.mjs && node scripts/seo-check.mjs && node scripts/seo-sample-report.mjs",
    "typecheck": "astro check",
    "deploy:main": "wrangler deploy --config wrangler.jsonc",
    "deploy:www": "wrangler deploy --config wrangler.redirects.jsonc",
    "deploy": "npm run deploy:main && npm run deploy:www"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "astro": "^5.18.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.0"
  }
}
