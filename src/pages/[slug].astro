---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import ProgrammaticPageView from "@/src/components/ProgrammaticPageView.astro";
import {
  getAllSEOPageIndex,
  getRelatedPages,
  getSEOPage,
  getSEOText,
} from "@/lib/seoGenerator";
import { getBuildTime } from "@/lib/build-time";
import { getPageIndexEligibility, getPairCities, robotsFor } from '@/lib/indexEligibility';
import { TimezoneExperience } from '@/components/timezone-experience';
import { relatedPairLinks, cityPairs } from '@/lib/siteInventory';

export function getStaticPaths() {
  return getAllSEOPageIndex().filter(page => getPageIndexEligibility(page).indexable).map((page) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = slug ? await getSEOPage(slug) : undefined;
if (!page) throw new Error(`Missing SEO page data for ${slug}`);
const related = await getRelatedPages(page);
const seo = getSEOText(page);
const referenceTime = getBuildTime();
const title = `${seo.title} | WhatDateTime`;
const pair = page.kind === 'timezone' ? getPairCities(page.slug) : undefined;
---

<BaseLayout title={title} description={seo.description} canonicalPath={`/${page.slug}`} robots={robotsFor(getPageIndexEligibility(page))}>
  {pair ? <TimezoneExperience client:load from={pair[0]} to={pair[1]} title={seo.h1} description={seo.description} path={`/${page.slug}`} initialTime={referenceTime} related={relatedPairLinks(page.slug)} directoryPath={cityPairs(pair[0].slug).length ? `/time/${pair[0].slug}/conversions` : undefined} /> : <ProgrammaticPageView page={page} related={related} referenceTime={referenceTime} />}
</BaseLayout>
