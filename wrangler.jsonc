{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatdatetime",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "whatdatetime.com",
      "custom_domain": true
    }
  ]
}
